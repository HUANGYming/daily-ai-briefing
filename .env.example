# Qwen3.8-Next 的 OpenAI-compatible 内部网关（不要提交真实地址或密钥）
QWEN_BASE_URL=https://qwen-gateway.internal/v1
QWEN_API_KEY=replace-with-service-token
QWEN_MODEL=Qwen3.8-Next

# 企业 SMTP；生产环境建议由 Airflow Connection 注入这些变量
SMTP_HOST=smtp.internal.example
SMTP_PORT=587
SMTP_USER=ai-briefing-service
SMTP_PASSWORD=replace-with-secret
SMTP_FROM=ai-briefing@internal.example

# 可选：以逗号分隔；生产中更推荐在 Airflow Variable AI_BRIEFING_RECIPIENTS 配置
AI_BRIEFING_RECIPIENTS=ai-team@internal.example
